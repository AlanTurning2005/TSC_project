<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <!-- Bản đồ mạng lưới giao thông Quận 1 & Hồ Con Rùa -->
        <net-file value="data/raw_data/q1_map.net.xml"/>

        <!-- Tuyến đường xe đã được hiệu chuẩn từ dữ liệu TomTom 1-phút -->
        <route-files value="calibrated_routes.rou.xml"/>

        <!-- Định nghĩa mô hình xe máy Việt Nam (Sublane Model) & phân tầng phương tiện -->
        <additional-files value="data/raw_data/vtypes.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="24356"/>
        <step-length value="0.5"/>
    </time>

    <processing>
        <!-- Kích hoạt Sublane Model: chia làn thành các dải phụ 0.8m cho xe máy luồn lách -->
        <lateral-resolution value="0.8"/>
        
        <!-- Xử lý va chạm và thời gian giải tỏa kẹt xe -->
        <collision.action value="warn"/>
        <time-to-teleport value="300"/>
    </processing>

    <gui_only>
        <gui-settings-file value=""/>
    </gui_only>
</configuration>
