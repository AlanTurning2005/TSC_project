# Byte-compiled / cache của Python
__pycache__/
*.py[cod]
*$py.class

# Môi trường ảo (Virtual environments)
venv/
env/
.venv/

# Cấu hình IDE / Editor
.vscode/
.idea/

# Các file log/kết quả đầu ra của SUMO phát sinh khi chạy
*tripinfo*.xml
*edgedata*.xml
*lanechange*.xml
*summary*.xml
*queue*.xml
*.log

# File trung gian khi chạy test hành vi hoặc sweep độ nhạy
macro_traffic_crawler/data/behavior_reports/**/*.xml
macro_traffic_crawler/data/behavior_reports/mini_corridor/
!macro_traffic_crawler/data/behavior_reports/tested_vtypes.add.xml
sumo_scenarios/lambda_sensitivity_sweep/

# Log của crawler
macro_traffic_crawler/*.log

# Bỏ qua file chứa key thật & crawler state lưu vết key
.env
*.env
macro_traffic_crawler/.env
macro_traffic_crawler/data/metadata/crawler_state.json

# Bỏ qua dữ liệu snapshot thô từ crawler (> 1GB)
macro_traffic_crawler/data/raw/*.json

# Database & Binary Cache
*.db
*.sqlite
*.sqlite3
*.npz

# File dữ liệu crawler lớn (> 5MB - 21MB) tránh làm phình repo
macro_traffic_crawler/data/processed/macro_traffic_history.csv
macro_traffic_crawler/data/processed/macro_traffic_dense_1min.csv

# File lộ trình phụ và checkpoint trung gian của SUMO
*.rou.alt.xml
*checkpoint_warmup*.xml

