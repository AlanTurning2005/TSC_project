<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <!-- Bản đồ mạng lưới giao thông Quận 1 & Vòng xoay Hồ Con Rùa -->
        <net-file value="../../data/raw_data/q1_map.net.xml"/>

        <!-- Tuyến đường xe đã hiệu chuẩn từ TomTom Probe Data 20/10 (6.28 tiếng) -->
        <route-files value="calibrated_routes_20261020_6h.rou.xml"/>

        <!-- Định nghĩa mô hình xe máy Việt Nam (Sublane, maxSpeed=9.72m/s) -->
        <additional-files value="../../data/raw_data/vtypes.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="22603"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <!-- Kích hoạt Sublane Model: chia làn 0.8m cho xe máy luồn lách -->
        <lateral-resolution value="0.8"/>
        
        <!-- Xử lý va chạm và thời gian giải tỏa kẹt xe chống deadlock -->
        <collision.action value="warn"/>
        <time-to-teleport value="120"/>
    </processing>

    <output>
        <!-- Xuất dữ liệu thống kê vận tốc và lưu lượng từng cạnh sau mô phỏng -->
        <edgedata-output value="simulation_edgedata_20261020_6h.xml"/>
    </output>
</configuration>
