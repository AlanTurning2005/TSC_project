<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <!-- Mạng lưới ưu tiên không đèn tín hiệu (Unsignalized Priority Network) -->
        <net-file value="q1_map_priority.net.xml"/>

        <!-- Tuyến đường lưu lượng thực tế hiệu chuẩn synthetic demand -->
        <route-files value="calibrated_priority_routes.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.2"/>
    </time>

    <processing>
        <!-- Kích hoạt Sublane Model: chia làn 0.25m cho xe máy luồn lách tự do (Mục 2.1) -->
        <lateral-resolution value="0.25"/>
        <collision.action value="warn"/>
        <time-to-teleport value="120"/>
    </processing>

    <output>
        <edgedata-output value="simulation_edgedata_priority.xml"/>
        <tripinfo-output value="tripinfo_priority.xml"/>
    </output>

    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="gui-settings.xml"/>
        <start value="true"/>
    </gui_only>
</configuration>
