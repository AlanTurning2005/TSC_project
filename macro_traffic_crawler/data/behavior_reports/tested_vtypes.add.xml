<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">
    <!-- ============================================================================== -->
    <!-- TỰ ĐỘNG SINH TỪ VTYPES_CONFIG.JSON: HÀNH VI XE HỖN HỢP TP.HCM (SUBLANE MODEL) -->
    <!-- ============================================================================== -->
    <vTypeDistribution id="hcmc_mixed">
        <!-- Phân loại: MOTORCYCLE (Xe máy: luồn lách tự do (arbitrary), cự ly ngang hẹp 0.2m, tận dụng làn phụ lcSublane=1.0, chen lấn lcPushy=0.8) -->
        <vType id="motorcycle" vClass="motorcycle" guiShape="motorcycle" probability="0.85" length="1.8" width="0.8" height="1.2" maxSpeed="9.72" accel="2.5" decel="4.5" emergencyDecel="6.0" sigma="0.5" minGap="0.5" latAlignment="arbitrary" minGapLat="0.2" lcSublane="1.0" lcPushy="0.8" lcAssertive="1.2" color="0,200,255"/>

        <!-- Phân loại: PASSENGER (Ô tô con: chạy giữa làn (center), giữ khoảng cách ngang 0.6m, ít chen lấn) -->
        <vType id="passenger" vClass="passenger" guiShape="passenger" probability="0.12" length="4.5" width="1.8" height="1.5" maxSpeed="9.72" accel="2.0" decel="4.0" emergencyDecel="6.0" sigma="0.4" minGap="1.5" latAlignment="center" minGapLat="0.6" lcSublane="0.5" lcPushy="0.2" color="255,255,0"/>

        <!-- Phân loại: BUS (Xe buýt đô thị: kích thước lớn, cồng kềnh, không luồn lách) -->
        <vType id="bus" vClass="bus" guiShape="bus" probability="0.03" length="10.5" width="2.5" height="3.2" maxSpeed="8.33" accel="1.2" decel="3.0" emergencyDecel="5.0" sigma="0.3" minGap="2.5" latAlignment="center" minGapLat="0.8" lcSublane="0.0" lcPushy="0.0" color="0,255,100"/>

    </vTypeDistribution>
</additional>